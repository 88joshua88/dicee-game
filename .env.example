# ============================================================
#  Stray Dog Blog — Environment Variables
#
#  Copy this file to .env in the SERVER directory for local
#  development:  cp .env.example server/.env
#
#  In Railway: add each variable below in the Railway dashboard
#  under your service → Variables tab.  Do NOT commit .env files.
# ============================================================

# ── Node environment ─────────────────────────────────────────
# Railway sets this automatically. Set to "production" in Railway.
NODE_ENV=production

# ── Server port ──────────────────────────────────────────────
# Railway injects PORT automatically — do NOT set this manually
# in Railway. Leave it out; the server reads process.env.PORT.
# For local development the server defaults to 5000.
# PORT=5000

# ── MongoDB Atlas ─────────────────────────────────────────────
# Create a free cluster at https://cloud.mongodb.com
# Connection string format:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/straydogblog?retryWrites=true&w=majority

# ── JSON Web Token ────────────────────────────────────────────
# Any long random string. Generate one with:  openssl rand -base64 64
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ── Cloudinary ───────────────────────────────────────────────
# Create a free account at https://cloudinary.com
# Find these values in your Cloudinary dashboard → Settings → Access Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Postmark (transactional email) ────────────────────────────
# Create an account at https://postmarkapp.com
# Generate a Server API Token in your Postmark account
# (Only required if you use the /api/email/test endpoint)
POSTMARK_API_KEY=your_postmark_server_api_token

# ============================================================
#  FRONTEND BUILD VARIABLE (Railway Build Variables tab)
#
#  DO NOT set VITE_API_URL in Railway — leave it unset.
#  When unset, the React app uses relative URLs (/api/...)
#  which work automatically since Express serves the built
#  React app from the same host.
#
#  For LOCAL DEVELOPMENT only, create client/.env:
#    VITE_API_URL=http://localhost:5000
# ============================================================
